
<!DOCTYPE html>
<html>
<head>
	<meta charset="UTF-8" />
    <link rel="stylesheet" href="/styles.css">
	<title>Leon Chang Gallery Signup</title>
</head>
    {{> header title="REGISTRATION"}}
    
    
    <div class ="login-container">
        <h2>Fill in the data to register</h2>
        <form class="login-form" method="post" action="/register">
            <input type="text" name="username" placeholder="Username" value="{{data.username}}" required />
            <input type="password" name="password" placeholder="Password" value="{{data.password}}" required />
            <input type="password2" name="password2" placeholder="Confirm Password"/>
            <button type="submit" class="register-btn">Register</button>
         </form>
         <form class = "login-form" method="get" action = "/">
            <button type="submit" class="submit-btn">back</button>
         </form>
        {{#if data.errorMessage}}
         <div class="errorMessage">
            <p>{{data.errorMessage}}</p>
         </div>
        {{/if}}
    </div>

    </form>